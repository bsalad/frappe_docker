#!/bin/sh
# The merge gate of depot finance: yardr depot check runs it in a bead's worktree, and
# a bead lands only when it exits 0. yardr reads this file from the base
# branch (main), so an edit here counts once it has landed there.
set -e
# The finance stack's compose files must parse together.
docker compose -f pwd.yml -f finance-local.yml config -q
# Upstream's own lint, when pre-commit is installed (optional for now).
if command -v pre-commit >/dev/null; then
  pre-commit run --all-files
fi
