#!/bin/sh
# The merge gate of depot finance: yardr depot check runs it in a bead's worktree, and
# a bead lands only when it exits 0. yardr reads this file from the base
# branch (main), so an edit here counts once it has landed there.
set -e
# The finance stack's compose files (live and the HRMS copy) must parse together.
docker compose -f pwd.yml -f finance-local.yml config -q
docker compose -f pwd.yml -f finance-copy.yml config -q
# The bi_finance layout and stamp guard, stdlib only (no frappe), so it runs on the host.
# A synced JSON changed without a newer 'modified' fails here; see test_layout.py.
(cd finance/apps/bi_finance && python3 -m unittest bi_finance.test_layout)
# The bi_payroll formulas and the payroll hand-over rows (invented employees) and its layout and stamp guard, stdlib only.
(cd finance/apps/bi_payroll && python3 -m unittest bi_payroll.test_swiss_payroll bi_payroll.test_hand_over bi_payroll.test_layout)
# The bexio importers' unit tests, stdlib only, about half a second.
(cd finance/bexio && python3 -m unittest discover -s . -p "test_*.py")
# The image app lists (live without hrms, copy with it) and build-image.sh's modes; no docker.
# switch-image.sh's decisions (which tag runs, which images go at rest) with stub docker and curl.
(cd finance/scripts && python3 -m unittest test_build_image test_switch_image)
# Upstream's own lint, when pre-commit is installed (optional for now).
if command -v pre-commit >/dev/null; then
  pre-commit run --all-files
fi
